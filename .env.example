# Web3Forms access key for the waitlist form.
# Get one free at https://web3forms.com (enter your email, they send a key — no account).
# This value is exposed in the client bundle by design; it only lets people submit YOUR form.
# Dev: copy this file to .env.local and paste your key. Prod: set the same var in Amplify.
VITE_WEB3FORMS_KEY=
